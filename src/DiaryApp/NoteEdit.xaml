<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DiaryApp.NoteEdit"
             Title="Edit note">

    <Grid>
        <!-- Rows:    0 = title, 1 = mood + exercise, 2 = the text (takes all the remaining space), 3 = date
             Columns: two equal halves, so two controls can sit side by side -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Title: row 0, spans both columns -->
        <Entry x:Name="TitleEntry" Placeholder="Title"
               Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="12,4" />

        <!-- Mood (left) and Exercise (Middel) and NoteDatePickeer (right) share row 1, one column each -->
        <Picker x:Name="MoodPicker" Title="Mood"
                Grid.Row="1" Grid.Column="0" Margin="12,4" />
        <Entry x:Name="ExerciseEntry" Placeholder="Exercise"
               Grid.Row="1" Grid.Column="1" Margin="12,4" />
        <DatePicker x:Name="NoteDatePicker"
                    Grid.Row="1" Grid.Column="2" Margin="12,4" />

        <!-- The note text: row 2 is the * row, so it fills whatever space is left -->
        <Editor x:Name="TextEditor" Placeholder="Write your note here..."
                Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="12,4" />

        
    </Grid>
</ContentPage>