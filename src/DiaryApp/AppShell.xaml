<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DiaryApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DiaryApp"
    Title="DiaryApp">   
<TabBar>
    <ShellContent Title="Home" Icon="home.svg" ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
    <ShellContent Title="Calendar" Icon="calender.svg" ContentTemplate="{DataTemplate local:CalendarPage}" Route="CalendarPage" />
    <ShellContent Title="ExercisePlanner" Icon="planner.svg" ContentTemplate="{DataTemplate local:ExercisePlanner}" Route="ExercisePlanner" /> 
    <ShellContent Title="Graph" Icon="graph.svg" ContentTemplate="{DataTemplate local:Grath}" Route="Grath" /> 
    <ShellContent Title="Notes" Icon="notes.svg" ContentTemplate="{DataTemplate local:Notes}" Route="Notes" /> 
    <ShellContent Title="Settings" Icon="settings.svg" ContentTemplate="{DataTemplate local:Settings}" Route="Settings" /> 
</TabBar> 

</Shell>
